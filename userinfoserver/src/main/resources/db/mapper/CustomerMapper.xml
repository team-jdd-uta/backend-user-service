<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.teamuta.userinfoserver.repository.CustomerRepository">

    <select id="selectCustomerNameByUserId" parameterType="map" resultType="String">
        SELECT c.name
        FROM customer c
        WHERE c.user_id = #{userId}
    </select>

    <update id="updateCustomerInfo" parameterType="map">
        UPDATE customer
        SET name = #{name},
            email = #{email}
        WHERE user_id = #{userId}
    </update>

</mapper>
